# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub (veja .gitignore).

# ---------- Banco de dados ----------
# String de conexão do Neon (região sa-east-1, endereço com -pooler). Obrigatória: o Neon é a única fonte de dados.
DATABASE_URL=
PORT=3000

# ---------- Login (modo web / Vercel) ----------
# Assina o cookie da sessão. Precisa ser FIXA. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
