# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub (veja .gitignore).

# ---------- De onde vêm os relatórios do SIGA ----------
# "graph" = Microsoft Graph API (funciona local e no Vercel)
# "local" = lê a pasta do OneDrive já sincronizada neste PC (só local, sem Azure)
# Se ficar vazio: usa "graph" quando AZURE_CLIENT_ID estiver preenchido, senão "local".
ONEDRIVE_MODO=

# --- modo local ---
# Exemplo: C:\Users\Micro\OneDrive - CGB ENERGIA LTDA\SETOR DE MEDIÇÃO\SIGA\Entrada
ONEDRIVE_PASTA_LOCAL=

# --- modo graph (registro do app no Azure: veja README-ONEDRIVE.md) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Informe UMA das três formas de achar o OneDrive/SharePoint:
ONEDRIVE_DRIVE_ID=
# Acesso restrito a UMA pasta (permissão Files.SelectedOperations.Selected): informe o ID da pasta (junto com ONEDRIVE_DRIVE_ID).
# Como achar os dois IDs: README-ONEDRIVE.md, seção 3, "Acesso restrito a uma pasta".
ONEDRIVE_PASTA_ID=
# e-mail da conta da EMPRESA dona do OneDrive (ex.: nome@empresa.com.br)
ONEDRIVE_USUARIO=
SHAREPOINT_SITE_ID=
# Pasta dentro do OneDrive onde caem os relatórios (sem barra no início). Ex.: SETOR DE MEDIÇÃO/SIGA/Entrada
ONEDRIVE_PASTA=

# --- vale para os dois modos ---
# Só lê arquivos cujo caminho contenha este texto (ignora maiúsculas). Útil quando a pasta tem outros arquivos.
# Exemplo para o consolidado de 2026: BANCOS 2026
ONEDRIVE_ARQUIVO=
# Quantos níveis de subpastas percorrer (0 = só a pasta informada). Padrão: 2
ONEDRIVE_PROFUNDIDADE=

# ---------- Banco de dados ----------
# Vazio = guarda em arquivos na pasta "dados" (modo local).
# No Vercel é obrigatório: string de conexão do Neon (região sa-east-1).
DATABASE_URL=
# Dica: use uma pasta FORA do OneDrive (ex.: C:\dev\farol-dados) para o OneDrive não sincronizar centenas de MB de dados.
DADOS_DIR=dados

# ---------- Segurança e agendamento ----------
# Chave que protege /api/sync e /api/banco. No Vercel, o Cron envia essa chave sozinho se a variável se chamar CRON_SECRET.
SYNC_SECRET=
# Local: roda a sincronização sozinha a cada N minutos (0 = só manual).
SYNC_INTERVALO_MIN=30
SYNC_AO_INICIAR=1
# Limite de tempo de uma execução (milissegundos). No Vercel Hobby use 50000.
SYNC_LIMITE_MS=50000
# Só entram dias a partir desta data
BANCO_INICIO=2026-01-01
PORT=3000

# ---------- Login (modo web / Vercel) ----------
# Assina o cookie da sessão. Precisa ser FIXA. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
